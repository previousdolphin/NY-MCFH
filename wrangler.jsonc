{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ny-mcfh",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  // Local dev answers as localhost, not as the staging route, so the dev sign-in bypass applies.
  "dev": { "port": 8794, "host": "localhost:8794", "local_protocol": "http", "upstream_protocol": "http" },
  "preview_urls": false,
  "observability": { "enabled": true },

  // The live domain is a route in front of the existing DNS records (which still point at
  // GitHub Pages). Removing the two nymetrocoalition.org routes puts the old static site back.
  "routes": [
    { "pattern": "staging.nymetrocoalition.org", "custom_domain": true },
    { "pattern": "nymetrocoalition.org/*", "zone_name": "nymetrocoalition.org" },
    { "pattern": "www.nymetrocoalition.org/*", "zone_name": "nymetrocoalition.org" }
  ],

  // The Worker renders every page. Only /static/* is served without running it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/static/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "ny-mcfh-db", "database_id": "261597c6-682f-4783-8cd8-f085e13503c2", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ny-mcfh-r2-media" }
  ],

  // Fires a scheduled publish when its time comes.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "SITE_HOST": "nymetrocoalition.org",
    "MEDIA_BASE": "/media",
    // Set both once the Zero Trust application exists. Until then the editor refuses everyone.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
